COMPOSE_PROJECT_NAME=gopherops

# Generate separate values with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
IDENTITY_DB_PASSWORD=

# Create this local PEM file; it is ignored by Git. The container runs with its owner UID/GID to read it.
IDENTITY_JWT_PRIVATE_KEY_FILE=./identity-jwt-private.pem
IDENTITY_RUNTIME_UID=
IDENTITY_RUNTIME_GID=
IDENTITY_JWT_ISSUER=gopherops-identity
IDENTITY_JWT_AUDIENCE=gopherops-api
IDENTITY_JWT_TTL=15m

# Local-only host port for connecting to MySQL from your machine.
MYSQL_HOST_PORT=3307
